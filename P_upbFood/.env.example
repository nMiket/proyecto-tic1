# PostgreSQL
POSTGRES_DB=upbfood
POSTGRES_USER=upbfood
POSTGRES_PASSWORD=change-me-local-password

# JWT
# Use a unique random value with at least 32 bytes in real environments.
APP_JWT_SECRET=change-me-with-a-random-secret-of-at-least-32-bytes
APP_JWT_ACCESS_TOKEN_MINUTES=15
APP_JWT_REFRESH_TOKEN_DAYS=7

# Set true only when using HTTPS.
APP_AUTH_COOKIE_SECURE=false
