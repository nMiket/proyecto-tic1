# PostgreSQL
POSTGRES_DB=upbfood
POSTGRES_USER=upbfood
POSTGRES_PASSWORD=change-me-local-password

# JWT
# Use a unique random value with at least 32 bytes in real environments.
APP_JWT_SECRET=change-me-with-a-random-secret-of-at-least-32-bytes
APP_JWT_ACCESS_TOKEN_MINUTES=15
APP_JWT_REFRESH_TOKEN_DAYS=7

# Set true only when using HTTPS.
APP_AUTH_COOKIE_SECURE=false

# Correo de notificaciones de UPBFood
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion
APP_NOTIFICACIONES_CORREO_DESTINO=tu_correo@gmail.com

APP_FRONTEND_URL=http://localhost

# Clave del encargado de la universidad (panel /upb/solicitudes, HU031).
# Usa un valor largo y aleatorio. Si se deja vacia, el panel queda deshabilitado.
APP_UPB_REVISOR_CLAVE=cambia-esta-clave-institucional

## Stripe para pasarela de pagos
STRIPE_SECRET_KEY=sk_test_tu_llave_aqui
STRIPE_PUBLISHABLE_KEY=pk_test_tu_llave_aqui